generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
}

enum DeliveryStatus {
  PENDENTE
  ENTREGUE
  CANCELADO
}

enum TransactionType {
  ENTRADA
  SAIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]
  transactions Transaction[]
  contacts     ContactLog[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  group     String? // ex.: PWI, Brejas, Encanto — de onde o cliente vem
  phone     String?
  notes     String? @db.Text
  active    Boolean  @default(true)
  optOut    Boolean  @default(false) // não quer receber mensagens
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales        Sale[]
  transactions Transaction[]
  contacts     ContactLog[]

  @@index([name])
}

// ---- CRM ----

enum ContactChannel {
  WHATSAPP
  LIGACAO
  PESSOALMENTE
  OUTRO
}

// MANUAL: registrado por um usuário. Os demais são para o envio automático (futuro):
// a automação cria QUEUED e o serviço de envio atualiza para SENT ou FAILED.
enum ContactStatus {
  MANUAL
  QUEUED
  SENT
  FAILED
}

// Modelo de mensagem com variáveis: {nome}, {dias}, {ultima_compra}, {valor_aberto}, {preco}
model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts ContactLog[]
}

// Histórico de contatos com o cliente (manuais hoje, automáticos no futuro)
model ContactLog {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel     ContactChannel  @default(WHATSAPP)
  status      ContactStatus   @default(MANUAL)
  templateId  String?
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  message     String?         @db.Text
  notes       String?         @db.Text
  error       String?         @db.Text // motivo de falha no envio automático
  scheduledAt DateTime? // envio automático agendado
  sentAt      DateTime        @default(now())
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])

  @@index([customerId, sentAt])
  @@index([status, scheduledAt])
}

// Lote de goma comprado do fornecedor (ex.: LO-20260519)
model Lot {
  id           String   @id @default(cuid())
  code         String   @unique
  purchaseDate DateTime @db.Date
  quantityKg   Decimal? @db.Decimal(10, 3)
  supplier     String?
  notes        String? @db.Text
  closed       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]
  transactions Transaction[] // compras e custos ligados ao lote
}

model Sale {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  date           DateTime       @db.Date
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  quantityKg     Decimal        @db.Decimal(10, 3)
  unitPrice      Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  deliveryStatus DeliveryStatus @default(PENDENTE)
  deliveredAt    DateTime?      @db.Date
  lotId          String?
  lot            Lot?           @relation(fields: [lotId], references: [id])
  notes          String? @db.Text
  legacyCode     String? // código da planilha original
  createdById    String?
  createdBy      User?          @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  payments SalePayment[]

  @@index([date])
  @@index([customerId])
}

// Lançamento do livro-caixa (aba Financeiro)
model Transaction {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  date          DateTime        @db.Date
  type          TransactionType
  category      String // Venda, Compra de lote, Embalagem, Equipamento, Transporte, Site/Marketing, Ajuste, Outros
  description   String? @db.Text
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod String?         @default("PIX")
  transferred   Boolean         @default(false) // já transferido para a conta (Nubank)
  transferredAt DateTime?       @db.Date
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id])
  lotId         String?
  lot           Lot?            @relation(fields: [lotId], references: [id])
  legacyCode    String?
  createdById   String?
  createdBy     User?           @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  allocations SalePayment[]

  @@index([date])
}

// Quanto de um recebimento foi usado para quitar cada venda
model SalePayment {
  id            String      @id @default(cuid())
  saleId        String
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)

  @@unique([saleId, transactionId])
}

model Setting {
  key   String @id
  value String @db.Text
}
